# Postgres (dev: docker compose up -d db)
DATABASE_URL=postgres://cityeat:cityeat@localhost:5434/cityeat

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public URL of the site (used for auth callbacks/cookies)
BETTER_AUTH_URL=http://localhost:3100

# Resend (leave empty in dev: OTP codes are printed to the server log)
RESEND_API_KEY=
EMAIL_FROM="City 食咩好 <noreply@example.com>"

# Comma-separated emails that become admins on sign-in
ADMIN_EMAILS=

# Where uploaded images are stored
UPLOAD_DIR=./data/uploads
